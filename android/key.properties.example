# Copy to android/key.properties and fill in before Play Store release build.
# Do NOT commit key.properties (already in .gitignore).

storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=van2-upload
storeFile=van2-upload-keystore.jks

# Generate keystore (one-time):
# keytool -genkey -v -keystore van2-upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias van2-upload
