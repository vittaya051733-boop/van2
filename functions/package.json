{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "deploy": "powershell -ExecutionPolicy Bypass -File ../scripts/deploy-functions-isolated.ps1",
    "deploy:otp": "powershell -ExecutionPolicy Bypass -File ../scripts/deploy-functions-isolated.ps1 -FunctionName sendEmailOtp verifyEmailOtp",
    "deploy:verifyTopUpSlip": "powershell -ExecutionPolicy Bypass -File ../scripts/deploy-functions-isolated.ps1 -FunctionName verifyTopUpSlip",
    "migrate:customer-users": "node migrate-users-to-customer-users.js"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "agora-access-token": "^2.0.4",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.2.5",
    "google-auth-library": "^9.15.1",
    "googleapis": "^144.0.0",
    "nodemailer": "^6.10.1",
    "sharp": "^0.34.5"
  }
}
