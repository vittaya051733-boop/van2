rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isAdminFromProfile() {
      return signedIn()
          && exists(/databases/$(database)/documents/users/$(uid()))
          && get(/databases/$(database)/documents/users/$(uid())).data != null
          && (
            get(/databases/$(database)/documents/users/$(uid())).data.role in ['admin', 'superadmin']
            || get(/databases/$(database)/documents/users/$(uid())).data.isAdmin == true
            || get(/databases/$(database)/documents/users/$(uid())).data.admin == true
          );
    }

    function isPrivilegedAdmin() {
      return isAdmin() || isAdminFromProfile();
    }

    function isSelf(userId) {
      return signedIn() && uid() == userId;
    }

    function authEmail() {
      return signedIn() ? request.auth.token.email : null;
    }

    function isRegistrationCollection(collection) {
      return collection in [
        'market_registrations',
        'shop_registrations',
        'restaurant_registrations',
        'pharmacy_registrations',
        'agriculture_registrations',
        'other_registrations'
      ];
    }

    function isRegistrationOwner(docId) {
      return docId == uid()
          || (resource.data.ownerId != null && resource.data.ownerId == uid())
          || (
            authEmail() != null
            && resource.data.email != null
            && resource.data.email == authEmail()
          );
    }

    function isRegistrationCreateOwner(docId) {
      return docId == uid()
          || (request.resource.data.ownerId != null
              && request.resource.data.ownerId == uid());
    }

    function isPublicProductVisible(data) {
      return data != null && data.isActive == true;
    }

    function isOrderParticipant(data) {
      return signedIn()
          && data != null
          && (
            (data.shopId != null && data.shopId == uid())
            || (data.shopOwnerId != null && data.shopOwnerId == uid())
            || (data.customerId != null && data.customerId == uid())
            || (data.driverId != null && data.driverId == uid())
          );
    }

    function isUnverifiedPromptPayOrder(data) {
      return data != null
          && data.paymentMethod != null
          && data.paymentMethod == 'promptpay_qr'
          && data.paymentStatus != null
          && data.paymentStatus != 'verified';
    }

    function canAccessOrderAsParticipant(data) {
      return signedIn()
          && data != null
          && (
            (data.customerId != null && data.customerId == uid())
            || (
              !isUnverifiedPromptPayOrder(data)
              && (
                (data.shopId != null && data.shopId == uid())
                || (data.shopOwnerId != null && data.shopOwnerId == uid())
                || (data.driverId != null && data.driverId == uid())
              )
            )
          );
    }

    function canCreateVan3NotificationForOrder() {
      return request.resource.data.orderId is string
          && request.resource.data.orderId != ''
          && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
          && signedIn()
          && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data != null
          && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerId != null
          && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerId == uid()
          && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.driverId != null
          && request.resource.data.recipientUid == get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.driverId
          && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerConfirmed == true
          && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.riderNotifyReady == true
          && !isUnverifiedPromptPayOrder(get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data);
    }

    function canCreateAppNotification() {
      return signedIn()
          && (
            request.resource.data.targetApp != 'van3'
            || request.resource.data.sourceApp != 'van2_customer'
            || canCreateVan3NotificationForOrder()
          );
    }

    function isCallParticipant(data) {
      return signedIn()
          && data != null
          && (
            (data.callerId != null && data.callerId == uid())
            || (data.calleeId != null && data.calleeId == uid())
          );
    }

    // แอปเช็คอัปเดต ต้องอ่านได้ก่อนล็อกอิน (ใช้ใน AppUpdateGate)
    match /app_updates/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isPrivilegedAdmin();
    }

    // สาขาระบบกลาง แอปทุกฝั่งอ่านเพื่อเช็กสถานะ/พิกัด/เวลาตัดรอบได้
    match /branches/{branchId} {
      allow get, list: if true;
      allow create, update, delete: if isPrivilegedAdmin();
    }

    // อัตราบวกเพิ่มราคากลางของระบบ (เช่น 7% = 0.07)
    match /pricing_config/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isPrivilegedAdmin();
    }

    // สินค้า (แอปโหลดจาก collection('products'))
    match /products/{productId} {
      allow get, list: if (signedIn() && resource.data.ownerUid == uid())
          || isPublicProductVisible(resource.data);

      allow create: if signedIn() && request.resource.data.ownerUid == uid();

      allow update: if signedIn()
          && resource.data.ownerUid == uid()
          && request.resource.data.ownerUid == uid();

      allow delete: if signedIn() && resource.data.ownerUid == uid();

      match /specifications/{specId} {
        allow get, list: if signedIn()
            && get(/databases/$(database)/documents/products/$(productId)).data.ownerUid == uid();
        allow create, update, delete: if signedIn()
            && get(/databases/$(database)/documents/products/$(productId)).data.ownerUid == uid();
      }
    }

    // โปรไฟล์ผู้ใช้ฝั่งลูกค้า (ใช้เก็บ fcmToken ฯลฯ)
    match /customer_users/{userId} {
      allow get: if isSelf(userId);
      allow create, update, delete: if isSelf(userId);
      allow list: if false;

      match /friends/{friendId} {
        allow get, list: if isSelf(userId);
        allow create, update, delete: if isSelf(userId);
      }
    }

    // โปรไฟล์ผู้ใช้เดิม (รองรับช่วง migration)
    match /users/{userId} {
      allow get: if isSelf(userId) || isPrivilegedAdmin();
      allow create, update, delete: if isSelf(userId);
      allow list: if isPrivilegedAdmin();

      match /friends/{friendId} {
        allow get, list: if isSelf(userId);
        allow create, update, delete: if isSelf(userId);
      }
    }

    // สถานะไรเดอร์ออนไลน์ (ใช้ในหน้าตะกร้าฝั่งลูกค้า และอัปเดตจากแอปไรเดอร์)
    match /riders/{riderId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isSelf(riderId);
    }

    // ข้อมูลสัญญา
    match /contracts/{userId} {
      allow get: if isSelf(userId);
      allow create, update, delete: if isSelf(userId);
      allow list: if false;
    }

    // โปรไฟล์ร้านแบบ public สำหรับลูกค้าใช้ดูชื่อ รูป และพิกัดล่าสุด
    match /public_shops/{shopId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isSelf(shopId);
    }

    // เอกสารลงทะเบียนร้านค้า
    // - get (single doc): ผู้ใช้ที่ล็อกอินอ่านได้ (ข้อมูลร้านสำหรับลูกค้า/ไรเดอร์)
    // - list/query: เจ้าของหรือแอดมิน
    match /{collection}/{docId} {
      allow get: if isRegistrationCollection(collection) && signedIn();

      allow list: if isRegistrationCollection(collection)
          && signedIn()
          && (
            isPrivilegedAdmin()
            || isRegistrationOwner(docId)
          );

      allow create: if isRegistrationCollection(collection)
          && signedIn()
          && isRegistrationCreateOwner(docId);

      allow update: if isRegistrationCollection(collection)
          && signedIn()
          && (
            docId == uid()
            || (resource.data.ownerId != null && resource.data.ownerId == uid())
          );

      allow delete: if isRegistrationCollection(collection)
          && signedIn()
          && (
            docId == uid()
            || (resource.data.ownerId != null && resource.data.ownerId == uid())
          );
    }

    // ห้องแชทสรุปบนหน้า Home (collection('chatRooms') where participants array-contains uid)
    match /chatRooms/{roomId} {
      allow read: if signedIn() && (uid() in resource.data.participants);
      allow create: if signedIn() && (uid() in request.resource.data.participants);
      allow update: if signedIn() && (uid() in resource.data.participants);
      allow delete: if isPrivilegedAdmin();
    }

    // แชท (collection('chats')/{chatId}/messages)
    match /chats/{chatId} {
      allow read: if signedIn() && (uid() in resource.data.participants);
      allow create: if signedIn() && (uid() in request.resource.data.participants);
      allow update: if signedIn() && (uid() in resource.data.participants);
      allow delete: if isPrivilegedAdmin();

      match /messages/{messageId} {
        allow get, list: if signedIn()
            && (uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow create: if signedIn()
            && (uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants)
            && request.resource.data.senderId == uid();
        allow update, delete: if isPrivilegedAdmin();
      }
    }

    // ออเดอร์
    match /orders/{orderId} {
      allow read: if canAccessOrderAsParticipant(resource.data);
      allow create: if isOrderParticipant(request.resource.data);
      allow update: if canAccessOrderAsParticipant(resource.data);
      allow delete: if isPrivilegedAdmin();

      match /timeline/{timelineId} {
        allow read, write: if signedIn()
            && canAccessOrderAsParticipant(get(/databases/$(database)/documents/orders/$(orderId)).data);
      }
    }

    // ตั้งค่าการทำงานของร้าน
    match /shop_operations/{shopId} {
      allow read, write: if isSelf(shopId);
    }

    // เครดิต
    match /credits/{creditId} {
      allow read: if signedIn() && resource.data.uid == uid();
      allow create: if signedIn() && request.resource.data.uid == uid();
      allow update, delete: if isPrivilegedAdmin();
    }

    // คำขอถอนเงิน
    match /withdraw_requests/{requestId} {
      allow read: if signedIn() && resource.data.uid == uid();
      allow create: if signedIn() && request.resource.data.uid == uid();
      allow update: if isPrivilegedAdmin();
      allow delete: if isPrivilegedAdmin();
    }

    // สถานะการโทร
    match /call_sessions/{channelId} {
      allow read: if isCallParticipant(resource.data);
      allow create: if isCallParticipant(request.resource.data);
      allow update: if isCallParticipant(resource.data);
      allow delete: if isPrivilegedAdmin();
    }

    // การแจ้งเตือนข้ามแอป (van1/van2/van3)
    match /app_notifications/{notificationId} {
      allow create: if canCreateAppNotification();
      allow get, list: if signedIn() && resource.data.recipientUid == uid();
      allow update: if signedIn()
          && resource.data.recipientUid == uid()
          && request.resource.data.recipientUid == resource.data.recipientUid;
      allow delete: if isPrivilegedAdmin();
    }

    match /payment_config/{documentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
