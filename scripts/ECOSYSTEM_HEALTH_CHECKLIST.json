{
  "id": "ECOSYSTEM-HEALTH",
  "titleTh": "ตรวจสุขภาพ Ecosystem ทั้งระบบ (รันครั้งเดียว)",
  "project": "van-merchant",
  "updated": "2026-08-13",
  "howToRun": "van2\\scripts\\ecosystem-health.ps1",
  "layers": [
    {
      "id": "L1",
      "titleTh": "โครงสร้างแชร์ (ถ้าพัง = ทุกแอป)",
      "points": [
        {
          "id": "L1-AUTH",
          "van": ["van1", "van2", "van3", "van4"],
          "resource": "Firebase Auth",
          "symptomTh": "login ไม่ได้ / token หมดอายุ",
          "auto": "manual"
        },
        {
          "id": "L1-FS-RULES",
          "van": ["van1", "van2", "van3", "van4"],
          "resource": "Firestore rules (default)",
          "symptomTh": "permission-denied ทุก listener",
          "auto": "compile+emulator"
        },
        {
          "id": "L1-FCM",
          "van": ["van1", "van2", "van3"],
          "resource": "FCM / push",
          "symptomTh": "แจ้งเตือนไม่มา แต่เปิดแอปเห็นข้อมูล",
          "auto": "manual"
        },
        {
          "id": "L1-APPCHECK",
          "van": ["van1", "van2", "van3", "van4"],
          "resource": "App Check",
          "symptomTh": "callable / Firestore ถูกบล็อก (app check)",
          "auto": "manual"
        },
        {
          "id": "L1-CF-VAN2",
          "van": ["van2", "van3", "van4"],
          "resource": "Cloud Functions (van2)",
          "symptomTh": "checkout / push / withdraw ล้ม",
          "auto": "manual"
        }
      ]
    },
    {
